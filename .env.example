# Copy to .env and fill in. Without a key the booth still runs - it falls back
# to the 16-structure offline pack, which is also exactly what happens when the
# venue wifi dies mid-fair.
ANTHROPIC_API_KEY=sk-ant-...

# --- optional tuning -------------------------------------------------------

# PORT=3000

# Longest prompt accepted. Also caps what a single request can cost.
# MAX_PROMPT_LENGTH=140

# Floor between calls from one client, in ms. Stops someone holding Enter down.
# MIN_INTERVAL_MS=1200

# Whole-booth ceilings. Past the daily one, the offline pack quietly takes over
# so a stuck loop or a viral QR code cannot drain the club's credits.
# MAX_CALLS_PER_MINUTE=40
# MAX_CALLS_PER_DAY=1500

# Force the offline pack even with a key present - handy for rehearsing the
# dead-wifi path before you are standing in a gym.
# MOCK=1

# What happens when the model says an exhibit depicts a real, identifiable
# person - a public figure, or a named teacher or classmate.
#   allow    build it as asked (default)
#   generic  the same statue, renamed so it identifies nobody
#   block    a grey block, same as a blocked word
# REAL_PEOPLE=allow
